# ============================================================
# MY OS — environment configuration
# Copy this file to .env.local and fill in your own values.
# NEVER commit real secrets.
# ============================================================

# ---- AI provider (optional) ----
# Without a key, the app runs in clearly-labelled DEMO mode:
# papers and feedback are generated by the built-in offline engine.
# With a key, real AI generation is used via the OpenAI-compatible API.
AI_PROVIDER=openai
AI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_BASE_URL=https://api.openai.com/v1
AI_TEMPERATURE=0.4
AI_MAX_TOKENS=4000

# ---- Database ----
# SQLite file lives at ./data/myos.db (created automatically).
DATABASE_URL="file:../data/myos.db"

# ---- App ----
NEXT_PUBLIC_APP_NAME=MY OS
