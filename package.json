{
  "name": "my-os",
  "version": "1.0.0",
  "private": true,
  "description": "MY OS — Class 12 Personal Operating System: AI study planner, revision centre, English lab, freelance CRM, and self-improvement.",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/prisma-schema.mjs generate && node scripts/prisma-schema.mjs db push --skip-generate && next build",
    "start": "next start",
    "postinstall": "node scripts/prisma-schema.mjs generate",
    "lint": "next lint",
    "db:push": "node scripts/prisma-schema.mjs db push",
    "db:generate": "node scripts/prisma-schema.mjs generate",
    "db:studio": "node scripts/prisma-schema.mjs studio",
    "setup": "node scripts/prisma-schema.mjs generate && node scripts/prisma-schema.mjs db push",
    "test": "node --test \"tests/**/*.test.mjs\""
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@prisma/client": "^5.22.0",
    "lucide-react": "^0.454.0",
    "motion": "^11.18.2",
    "next": "^14.2.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3"
  }
}
